# Reusable orchestrator config for any repository
# Copy to your target repo root as: .orch.env

# Execution mode: local or remote
ORCH_MODE=remote

# Remote SSH
REMOTE_HOST=192.168.88.246
REMOTE_USER=hermes-agent
SSH_PORT=22

# Paths on remote server
# Set REMOTE_PROJECT_DIR to the already-cloned target repository path.
REMOTE_PROJECT_DIR=/home/hermes-agent/projects/history
REMOTE_ORCH_DIR=/home/hermes-agent/projects/llm-orchestrator

# Local orchestrator source on Mac (used by orch:remote:setup local-sync mode)
ORCH_LOCAL_DIR=/Users/romkravets/Documents/GitHub/llm-orchestrator

# Optional git source for server-side clone/pull mode.
# If empty, setup uses local-sync from ORCH_LOCAL_DIR.
ORCH_GIT_URL=
