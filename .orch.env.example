# Reusable orchestrator config for any repository
# Copy to your target repo root as: .orch.env

# Execution mode: local or remote
ORCH_MODE=remote

# Remote SSH
REMOTE_HOST=192.0.2.10
REMOTE_USER=your-remote-user
SSH_PORT=22

# Paths on remote server
# Set REMOTE_PROJECT_DIR to the already-cloned target repository path.
REMOTE_PROJECT_DIR=/home/your-remote-user/projects/history
REMOTE_ORCH_DIR=/home/your-remote-user/projects/llm-orchestrator

# Local orchestrator source on Mac (used by orch:remote:setup local-sync mode)
ORCH_LOCAL_DIR=/path/to/llm-orchestrator

# Optional git source for server-side clone/pull mode.
# If empty, setup uses local-sync from ORCH_LOCAL_DIR.
ORCH_GIT_URL=

# LLM runtime (read by llm-orchestrator on remote server)
LLM_ORCH_PROVIDER=hermes
LLM_ORCH_MODEL=tencent/hy3:free
LLM_ORCH_FALLBACK_OLLAMA=true
LLM_ORCH_OLLAMA_URL=http://127.0.0.1:11434
LLM_ORCH_OLLAMA_FALLBACK_MODEL=qwen2.5-coder:7b
