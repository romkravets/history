# Per-repository orchestrator config
# Copy to .orch.env and adjust values for this repository.

# Execution mode: local or remote
ORCH_MODE=remote

# Remote SSH
REMOTE_HOST=192.168.88.246
REMOTE_USER=adminr
SSH_PORT=22

# Paths on remote server
REMOTE_PROJECT_DIR=/home/adminr/projects/history
REMOTE_ORCH_DIR=/opt/llm-orchestrator

# Orchestrator source on Mac (used by orch:remote:setup local-sync mode)
ORCH_LOCAL_DIR=/Users/romkravets/Documents/GitHub/llm-orchestrator

# Optional git source for server-side clone/pull mode.
# If empty, setup uses local-sync from ORCH_LOCAL_DIR.
ORCH_GIT_URL=
