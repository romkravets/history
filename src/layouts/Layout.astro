---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import {
  SITE,
  AUTHOR,
  HOME_PLACE,
  SITE_NAME,
  SITE_TAGLINE,
  absoluteUrl,
  imageSize,
} from "../lib/site";
import { LANGS, LANG_META, langFromPath, lp, switchLang, t } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  /** Шлях до картинки для прев'ю в соцмережах (від кореня public/). */
  image?: string;
  imageAlt?: string;
  /** Розміри картинки прев'ю, якщо її немає в public/ (згенерований банер). */
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  /** Додаткові JSON-LD об'єкти для цієї сторінки. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const path = Astro.url.pathname;
const lang = langFromPath(path);
const T = t(lang);
const {
  title = `${T.tagline} · ${T.siteName}`,
  description = T.defaultDescription(T.coverage),
  image = "/video/banner-poster.jpg",
  imageAlt = T.siteName,
  imageWidth,
  imageHeight,
  type = "website",
  jsonLd = [],
  noindex = false,
} = Astro.props;

const canonical = absoluteUrl(path, Astro.site);
// шлях без мовного префікса — для підсвічування пункту меню
const bare = path.replace(/^\/pl(?=\/|$)/, "") || "/";
const NAV = [
  { href: "/", label: T.nav.gallery, active: bare === "/" || bare.startsWith("/photos/") },
  { href: "/karta/", label: T.nav.map, active: bare.startsWith("/karta") },
  { href: "/marshruty/", label: T.nav.routes, active: bare.startsWith("/marshruty") },
  { href: "/lyudy/", label: T.nav.people, active: bare.startsWith("/lyudy") },
  { href: "/biblioteka/", label: T.nav.library, active: bare.startsWith("/biblioteka") },
  { href: "/istoriya/", label: T.nav.history, active: bare.startsWith("/istoriya") },
  { href: "/about/", label: T.nav.about, active: bare.startsWith("/about") },
].map((item) => ({ ...item, href: lp(lang, item.href) }));
// 404 є лише українською — для неї альтернатив немає
const alternates = noindex
  ? []
  : LANGS.map((l) => ({ lang: l, href: absoluteUrl(switchLang(path, l), Astro.site) }));
const home = lp(lang, "/");
const siteUrl = absoluteUrl("/", Astro.site);
const ogImage = absoluteUrl(image, Astro.site);
const ogImageSize =
  imageWidth && imageHeight ? { width: imageWidth, height: imageHeight } : await imageSize(image);
const ogImageType = /\.png$/i.test(image) ? "image/png" : "image/jpeg";

const graph = [
  {
    "@type": "WebSite",
    "@id": `${siteUrl}#website`,
    url: siteUrl,
    name: SITE_NAME,
    alternateName: t("pl").siteName,
    description: SITE_TAGLINE,
    inLanguage: [...LANGS],
    publisher: { "@id": `${siteUrl}#author` },
    spatialCoverage: [
      { "@type": "Country", name: T.country },
      {
        "@type": "Place",
        name: `${HOME_PLACE.name}, ${HOME_PLACE.region}, Україна`,
        geo: {
          "@type": "GeoCoordinates",
          latitude: HOME_PLACE.latitude,
          longitude: HOME_PLACE.longitude,
        },
      },
    ],
  },
  {
    "@type": "Person",
    "@id": `${siteUrl}#author`,
    name: AUTHOR.name,
    url: AUTHOR.url,
    sameAs: [AUTHOR.url],
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={alternates[0]!.href} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content={AUTHOR.name} />
    <meta name="theme-color" content="#1a1411" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={T.siteName} />
    <meta property="og:locale" content={LANG_META[lang].og} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LANG_META[l].og} />)}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={imageAlt} />
    {ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)} />}
    {ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="geo.region" content={HOME_PLACE.regionCode} />
    <meta name="geo.placename" content={HOME_PLACE.name} />
    <meta name="geo.position" content={`${HOME_PLACE.latitude};${HOME_PLACE.longitude}`} />
    <meta name="ICBM" content={`${HOME_PLACE.latitude}, ${HOME_PLACE.longitude}`} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Unbounded:wght@500;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="bg-atmosphere" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href={home}>
        <span class="brand-dot" aria-hidden="true"></span>
        {T.brand}
      </a>
      <nav class="lang-switch" aria-label={T.langSwitch}>
        {LANGS.map((l) => (
          <a
            href={switchLang(path, l)}
            hreflang={l}
            lang={l}
            title={LANG_META[l].name}
            aria-current={l === lang ? "true" : undefined}
          >
            {LANG_META[l].label}
          </a>
        ))}
      </nav>
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="top-nav"
        aria-label={T.menuOpen}
        data-label-open={T.menuOpen}
        data-label-close={T.menuClose}
      >
        <span aria-hidden="true"></span>
      </button>
      <nav class="top-nav" id="top-nav" aria-label={T.mainNav}>
        {
          NAV.map((item) => (
            <a href={item.href} aria-current={item.active ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell site-footer-grid">
        <div class="footer-about">
          <a class="brand" href={home}>
            <span class="brand-dot" aria-hidden="true"></span>
            {T.siteName}
          </a>
          <p>{T.tagline}. {T.footerAbout}</p>
        </div>
        <nav class="footer-nav" aria-label={T.footerSections}>
          <p class="footer-title">{T.footerSections}</p>
          {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <div class="footer-author">
          <p class="footer-title">{T.footerAuthor}</p>
          <span>{T.authorName}</span>
          {SITE.author.github && (
            <a href={SITE.author.github} target="_blank" rel="me noopener noreferrer">GitHub ↗</a>
          )}
          {SITE.author.linkedin && (
            <a href={SITE.author.linkedin} target="_blank" rel="me noopener noreferrer">LinkedIn ↗</a>
          )}
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} {T.siteName}</span>
        <span>{T.footerRights}</span>
      </div>
    </footer>

    <button type="button" class="to-top" aria-label={T.toTop} hidden>↑</button>
    <script is:inline>
      (() => {
        // бургер-меню для планшетів і телефонів
        const header = document.querySelector(".site-header");
        const toggle = document.querySelector(".nav-toggle");
        if (!header || !toggle) return;
        const set = (open) => {
          header.classList.toggle("nav-open", open);
          toggle.setAttribute("aria-expanded", String(open));
          toggle.setAttribute("aria-label", open ? toggle.dataset.labelClose : toggle.dataset.labelOpen);
        };
        toggle.addEventListener("click", () => set(!header.classList.contains("nav-open")));
        document.addEventListener("keydown", (e) => e.key === "Escape" && set(false));
        document.addEventListener("click", (e) => {
          if (header.classList.contains("nav-open") && !header.contains(e.target)) set(false);
        });
        matchMedia("(min-width: 901px)").addEventListener("change", (e) => e.matches && set(false));
      })();
    </script>
    <script is:inline>
      (() => {
        // кнопка «нагору» — з'являється, коли сторінку прогорнуто далеко вниз
        const btn = document.querySelector(".to-top");
        if (!btn) return;
        const update = () => {
          const root = document.documentElement;
          btn.hidden = !(root.scrollTop > Math.max(600, innerHeight * 1.2));
        };
        btn.addEventListener("click", () => {
          const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;
          window.scrollTo({ top: 0, behavior: smooth ? "smooth" : "auto" });
          document.querySelector(".brand")?.focus({ preventScroll: true });
        });
        addEventListener("scroll", update, { passive: true });
        update();
      })();
    </script>
    <script is:inline>
      (() => {
        const bar = document.querySelector(".scroll-progress");
        if (!bar) return;
        const onScroll = () => {
          const root = document.documentElement;
          const max = root.scrollHeight - root.clientHeight;
          const ratio = max > 0 ? (root.scrollTop / max) * 100 : 0;
          bar.style.width = ratio + "%";
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      })();
    </script>
    <Analytics />
  </body>
</html>
