---
import "../styles/global.css";
import {
  SITE,
  AUTHOR,
  HOME_PLACE,
  SITE_NAME,
  SITE_TAGLINE,
  absoluteUrl,
  imageSize,
} from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  /** Шлях до картинки для прев'ю в соцмережах (від кореня public/). */
  image?: string;
  imageAlt?: string;
  /** Розміри картинки прев'ю, якщо її немає в public/ (згенерований банер). */
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article";
  /** Додаткові JSON-LD об'єкти для цієї сторінки. */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = `${SITE_TAGLINE} · ${SITE_NAME}`,
  description = `Цифровий архів старих фотографій і листівок ${SITE.texts.coverage}: дати, описи та історія місць.`,
  image = "/video/banner-poster.jpg",
  imageAlt = SITE_NAME,
  imageWidth,
  imageHeight,
  type = "website",
  jsonLd = [],
  noindex = false,
} = Astro.props;

const canonical = absoluteUrl(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const NAV = [
  { href: "/", label: "Галерея", active: path === "/" || path.startsWith("/photos/") },
  { href: "/karta/", label: "Карта", active: path.startsWith("/karta") },
  { href: "/lyudy/", label: "Люди", active: path.startsWith("/lyudy") },
  { href: "/biblioteka/", label: "Бібліотека", active: path.startsWith("/biblioteka") },
  { href: "/istoriya/", label: "Історія", active: path.startsWith("/istoriya") },
  { href: "/about/", label: "Про архів", active: path.startsWith("/about") },
];
const siteUrl = absoluteUrl("/", Astro.site);
const ogImage = absoluteUrl(image, Astro.site);
const ogImageSize =
  imageWidth && imageHeight ? { width: imageWidth, height: imageHeight } : await imageSize(image);
const ogImageType = /\.png$/i.test(image) ? "image/png" : "image/jpeg";

const graph = [
  {
    "@type": "WebSite",
    "@id": `${siteUrl}#website`,
    url: siteUrl,
    name: SITE_NAME,
    description: SITE_TAGLINE,
    inLanguage: "uk",
    publisher: { "@id": `${siteUrl}#author` },
    spatialCoverage: [
      { "@type": "Country", name: "Україна" },
      {
        "@type": "Place",
        name: `${HOME_PLACE.name}, ${HOME_PLACE.region}, Україна`,
        geo: {
          "@type": "GeoCoordinates",
          latitude: HOME_PLACE.latitude,
          longitude: HOME_PLACE.longitude,
        },
      },
    ],
  },
  {
    "@type": "Person",
    "@id": `${siteUrl}#author`,
    name: AUTHOR.name,
    url: AUTHOR.url,
    sameAs: [AUTHOR.url],
  },
  ...jsonLd,
];
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="author" content={AUTHOR.name} />
    <meta name="theme-color" content="#1a1411" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="uk_UA" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={imageAlt} />
    {ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)} />}
    {ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="geo.region" content={HOME_PLACE.regionCode} />
    <meta name="geo.placename" content={HOME_PLACE.name} />
    <meta name="geo.position" content={`${HOME_PLACE.latitude};${HOME_PLACE.longitude}`} />
    <meta name="ICBM" content={`${HOME_PLACE.latitude}, ${HOME_PLACE.longitude}`} />

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Unbounded:wght@500;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="bg-atmosphere" aria-hidden="true"></div>
    <header class="site-header">
      <a class="brand" href="/">
        <span class="brand-dot" aria-hidden="true"></span>
        АРХІВ ІСТОРІЇ
      </a>
      <nav class="top-nav" aria-label="Головна навігація">
        {
          NAV.map((item) => (
            <a href={item.href} aria-current={item.active ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell site-footer-inner">
        <span>ІСТОРИЧНИЙ АРХІВ КРЕМЕНЕЧЧИНИ</span>
        <a
          href="https://github.com/romkravets"
          target="_blank"
          rel="me noopener noreferrer"
        >
          Розробник: Роман Кравець · GitHub
        </a>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const bar = document.querySelector(".scroll-progress");
        if (!bar) return;
        const onScroll = () => {
          const root = document.documentElement;
          const max = root.scrollHeight - root.clientHeight;
          const ratio = max > 0 ? (root.scrollTop / max) * 100 : 0;
          bar.style.width = ratio + "%";
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      })();
    </script>
  </body>
</html>
