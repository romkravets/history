---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BeforeAfter from "../../components/BeforeAfter.astro";
import {
  SITE,
  OG_HEIGHT,
  OG_WIDTH,
  SITE_NAME,
  absoluteUrl,
  imageSize,
  mentionsCity,
  regionOf,
} from "../../lib/site";

export async function getStaticPaths() {
  // той самий порядок, що й на головній: від найновіших
  const photos = (await getCollection("photos")).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const link = (p: (typeof photos)[number]) => ({
    href: `/photos/${p.id.replace(/\.md$/, "")}/`,
    title: p.data.title,
  });
  const at = (i: number) => photos[(i + photos.length) % photos.length]!;
  return photos.map((photo, i) => ({
    params: { slug: photo.id.replace(/\.md$/, "") },
    props: {
      photo,
      prev: link(at(i - 1)),
      next: link(at(i + 1)),
      position: i + 1,
      total: photos.length,
    },
  }));
}

const { photo, prev, next, position, total } = Astro.props;
const relatedPeople = (await getCollection("people")).filter((p) =>
  p.data.galleries.includes(photo.id.replace(/\.md$/, "")),
);
const { Content } = await render(photo);

const formatDate = new Intl.DateTimeFormat("uk-UA", {
  dateStyle: "long",
});

const { title, city, area, decade, description, cover, images, captions, tags, location } =
  photo.data;
const slug = photo.id.replace(/\.md$/, "");
const region = regionOf(city);
const allImages = [cover, ...images];
const sizes = await Promise.all(allImages.map((src) => imageSize(src)));
const altFor = (idx: number) =>
  captions[allImages[idx]]
    ? `${captions[allImages[idx]]} — ${city}`
    : idx === 0
    ? `${title} — ${city}${area ? `, ${area}` : ""}`
    : `${title} — ${city}, фото ${idx + 1} з ${allImages.length}`;

const isModern = /сучасн/i.test(decade);
const kind = /фото|світлин|листівк|знімк|реконструкц|малюнк|гравюр|карт/i.test(title)
  ? ""
  : isModern
    ? " — фото"
    : " — старі фото";
const pageTitle = `${title}${mentionsCity(title, city) ? "" : `, ${city}`}${kind} · ${SITE_NAME}`;

const pageUrl = absoluteUrl(Astro.url.pathname, Astro.site);
const fb = SITE.feedback;
const feedbackBase = fb.formUrl
  ? (() => {
      const u = new URL(fb.formUrl);
      u.searchParams.set("usp", "pp_url");
      if (fb.fields.gallery) u.searchParams.set(fb.fields.gallery, title);
      if (fb.fields.url) u.searchParams.set(fb.fields.url, pageUrl);
      return u.href;
    })()
  : "";
const shareText = `${title} — ${description}`;
const enc = encodeURIComponent;
const shareLinks = [
  { name: "Facebook", href: `https://www.facebook.com/sharer/sharer.php?u=${enc(pageUrl)}` },
  { name: "Telegram", href: `https://t.me/share/url?url=${enc(pageUrl)}&text=${enc(title)}` },
  { name: "Viber", href: `viber://forward?text=${enc(`${title} ${pageUrl}`)}` },
  { name: "WhatsApp", href: `https://wa.me/?text=${enc(`${title} ${pageUrl}`)}` },
  { name: "X", href: `https://twitter.com/intent/tweet?url=${enc(pageUrl)}&text=${enc(title)}` },
];
const siteUrl = absoluteUrl("/", Astro.site);
const place = {
  "@type": "Place",
  name: area ? `${city}, ${area}` : city,
  ...(location
    ? { geo: { "@type": "GeoCoordinates", latitude: location.lat, longitude: location.lng } }
    : {}),
  address: {
    "@type": "PostalAddress",
    addressLocality: city,
    addressRegion: region,
    addressCountry: "UA",
  },
};
const jsonLd = [
  {
    "@type": "ImageGallery",
    "@id": `${pageUrl}#gallery`,
    url: pageUrl,
    name: title,
    headline: title,
    description,
    inLanguage: "uk",
    isPartOf: { "@id": `${siteUrl}#website` },
    author: { "@id": `${siteUrl}#author` },
    publisher: { "@id": `${siteUrl}#author` },
    contentLocation: place,
    spatialCoverage: place,
    temporalCoverage: decade,
    keywords: tags.join(", "),
    primaryImageOfPage: { "@id": `${pageUrl}#image-1` },
    image: allImages.map((src, idx) => ({
      "@type": "ImageObject",
      "@id": `${pageUrl}#image-${idx + 1}`,
      contentUrl: absoluteUrl(src, Astro.site),
      caption: altFor(idx),
      ...(sizes[idx] ?? {}),
    })),
  },
  {
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Галерея", item: siteUrl },
      { "@type": "ListItem", position: 2, name: title, item: pageUrl },
    ],
  },
];
---

<Layout
  title={pageTitle}
  description={description}
  image={`/og/${slug}.jpg`}
  imageAlt={altFor(0)}
  imageWidth={OG_WIDTH}
  imageHeight={OG_HEIGHT}
  type="article"
  jsonLd={jsonLd}
>
  <article class="shell photo-article">
    <div class="photo-topbar">
      <a class="back-link" href="/#gallery">← Усі галереї</a>
      <div class="topbar-pager">
        <a href={prev.href} title={`Попередня: ${prev.title}`} aria-label={`Попередня галерея: ${prev.title}`}>←</a>
        <span>{position} / {total}</span>
        <a href={next.href} title={`Наступна: ${next.title}`} aria-label={`Наступна галерея: ${next.title}`}>→</a>
      </div>
    </div>
    <header class="photo-header">
      <p class="eyebrow">{photo.data.city}{photo.data.area ? ` · ${photo.data.area}` : ""}</p>
      <h1>{photo.data.title}</h1>
      <p class="lead">{photo.data.description}</p>
      <div class="meta-row">
        <span>{formatDate.format(photo.data.date)}</span>
        <span>{photo.data.decade}</span>
        {location && <a class="map-link" href={`/karta/#${slug}`}>◉ На карті</a>}
        {
          photo.data.tags.length > 0 &&
            <span>{photo.data.tags.map((tag: string) => `#${tag}`).join(" ")}</span>
        }
      </div>

      {
        feedbackBase && (
          <div class="feedback-cta">
            <p>Впізнали місце чи людей? Маєте старі фото цього місця?</p>
            <a class="btn btn-accent" href={feedbackBase} target="_blank" rel="noopener noreferrer">
              Знаєте, що на фото? Напишіть →
            </a>
            <a class="btn" href={feedbackBase} target="_blank" rel="noopener noreferrer">Надіслати своє фото</a>
          </div>
        )
      }

      <div class="share" data-share-url={pageUrl} data-share-title={title} data-share-text={shareText}>
        <span class="share-label">Поділитися:</span>
        <button type="button" class="share-btn share-native" hidden>Поділитися…</button>
        {
          shareLinks.map((l) => (
            <a class="share-btn" href={l.href} target="_blank" rel="noopener noreferrer" aria-label={`Поділитися в ${l.name}`}>
              {l.name}
            </a>
          ))
        }
        <button type="button" class="share-btn share-copy">Копіювати посилання</button>
      </div>
    </header>

    <figure class="main-photo">
      <img
        src={cover}
        alt={altFor(0)}
        title={captions[cover]}
        width={sizes[0]?.width}
        height={sizes[0]?.height}
        loading="eager"
        fetchpriority="high"
        class="lightbox-trigger"
        data-lightbox-index="0"
      />
    </figure>

    {
      photo.data.comparisons.length > 0 && (
        <section class="ba-section" aria-label="Тоді й тепер">
          <h2 class="section-title">Тоді й тепер <small>— потягніть повзунок</small></h2>
          <div class="ba-list">
            {photo.data.comparisons.map((c) => (
              <BeforeAfter before={c.before} after={c.after} caption={c.caption} />
            ))}
          </div>
        </section>
      )
    }

    {
      photo.data.images.length > 0 && (
        <section class="gallery-grid" aria-label="Додаткові фотографії">
          {photo.data.images.map((src: string, idx: number) => (
            <img
              src={src}
              alt={altFor(idx + 1)}
              title={captions[src]}
              width={sizes[idx + 1]?.width}
              height={sizes[idx + 1]?.height}
              loading="lazy"
              decoding="async"
              class="lightbox-trigger"
              data-lightbox-index={idx + 1}
            />
          ))}
        </section>
      )
    }

    <section class="story">
      <Content />
    </section>

    {
      relatedPeople.length > 0 && (
        <section class="related">
          <h2>Люди, пов'язані з цією галереєю</h2>
          <p class="related-people">
            {relatedPeople.map((p) => (
              <a href={`/lyudy/${p.id.replace(/\.md$/, "")}/`}>
                {p.data.name} <small>{p.data.role}</small>
              </a>
            ))}
          </p>
        </section>
      )
    }

    <nav class="gallery-pager" aria-label="Інші галереї">
      <a class="pager-link pager-prev" href={prev.href} rel="prev">
        <span class="pager-arrow" aria-hidden="true">←</span>
        <span class="pager-text">
          <small>Попередня галерея</small>
          <b>{prev.title}</b>
        </span>
      </a>
      <span class="pager-pos">{position} / {total}</span>
      <a class="pager-link pager-next" href={next.href} rel="next">
        <span class="pager-text">
          <small>Наступна галерея</small>
          <b>{next.title}</b>
        </span>
        <span class="pager-arrow" aria-hidden="true">→</span>
      </a>
    </nav>
  </article>

  <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Перегляд фото">
    <button type="button" class="lightbox-close" data-lightbox-close aria-label="Закрити">✕</button>
    <button type="button" class="lightbox-nav lightbox-prev" data-lightbox-prev aria-label="Попереднє фото">‹</button>
    <img class="lightbox-image" alt="" />
    <button type="button" class="lightbox-nav lightbox-next" data-lightbox-next aria-label="Наступне фото">›</button>
    <p class="lightbox-counter"></p>
    {
      feedbackBase && (
        <a
          class="lightbox-feedback"
          href={feedbackBase}
          data-base={feedbackBase}
          data-photo-field={fb.fields.photo}
          target="_blank"
          rel="noopener noreferrer"
        >
          Знаєте, що на цьому фото?
        </a>
      )
    }
  </div>

  <script is:inline>
    (() => {
      const box = document.querySelector(".share");
      if (!box) return;
      const { shareUrl: url, shareTitle: title, shareText: text } = box.dataset;
      const native = box.querySelector(".share-native");
      // на телефонах — системне меню «Поділитися» (усі встановлені месенджери)
      if (navigator.share && native) {
        native.hidden = false;
        native.addEventListener("click", () => navigator.share({ title, text, url }).catch(() => {}));
      }
      const copy = box.querySelector(".share-copy");
      copy?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(url);
        } catch {
          const t = document.createElement("textarea");
          t.value = url; document.body.append(t); t.select(); document.execCommand("copy"); t.remove();
        }
        const old = copy.textContent;
        copy.textContent = "Скопійовано ✓";
        copy.classList.add("is-done");
        setTimeout(() => { copy.textContent = old; copy.classList.remove("is-done"); }, 2000);
      });
    })();
  </script>

  <script
    is:inline
    type="application/json"
    id="lightbox-data"
    set:html={JSON.stringify([
      ...allImages.map((src, idx) => ({
        src,
        alt: altFor(idx),
        caption: captions[src] ?? "",
      })),
    ])}
  />

  <script is:inline>
    (() => {
      const dataEl = document.getElementById("lightbox-data");
      const items = dataEl ? JSON.parse(dataEl.textContent || "[]") : [];
      const box = document.getElementById("lightbox");
      if (!box || items.length === 0) return;

      const img = box.querySelector(".lightbox-image");
      const counter = box.querySelector(".lightbox-counter");
      let current = 0;

      const show = (i) => {
        current = (i + items.length) % items.length;
        img.src = items[current].src;
        img.alt = items[current].alt;
        counter.textContent = items[current].caption
          ? `${current + 1} / ${items.length} · ${items[current].caption}`
          : `${current + 1} / ${items.length}`;
        // адреса конкретного фото (#foto-3) — щоб ним можна було поділитися
        if (box.classList.contains("is-open"))
          history.replaceState(null, "", `#foto-${current + 1}`);
        // посилання на форму з номером і підписом саме цього фото
        const fbLink = box.querySelector(".lightbox-feedback");
        if (fbLink && fbLink.dataset.photoField) {
          const u = new URL(fbLink.dataset.base);
          u.searchParams.set(
            fbLink.dataset.photoField,
            `Фото ${current + 1} з ${items.length}${items[current].caption ? ` — ${items[current].caption}` : ""} (${location.origin}${location.pathname}#foto-${current + 1})`,
          );
          fbLink.href = u.href;
        }
      };

      const open = (i) => {
        box.classList.add("is-open");
        show(i);
        box.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
      };

      const close = () => {
        if (/^#foto-\d+$/.test(location.hash))
          history.replaceState(null, "", location.pathname + location.search);
        box.classList.remove("is-open");
        box.setAttribute("aria-hidden", "true");
        document.body.style.overflow = "";
      };

      document.querySelectorAll(".lightbox-trigger").forEach((el) => {
        el.style.cursor = "zoom-in";
        el.addEventListener("click", () => {
          open(Number(el.dataset.lightboxIndex || 0));
        });
      });

      box.querySelector("[data-lightbox-close]").addEventListener("click", close);
      box.querySelector("[data-lightbox-prev]").addEventListener("click", () => show(current - 1));
      box.querySelector("[data-lightbox-next]").addEventListener("click", () => show(current + 1));
      box.addEventListener("click", (e) => {
        if (e.target === box) close();
      });

      window.addEventListener("keydown", (e) => {
        if (!box.classList.contains("is-open")) {
          // поза лайтбоксом стрілки гортають галереї
          const t = e.target;
          if (t instanceof HTMLElement && /INPUT|TEXTAREA|SELECT/.test(t.tagName)) return;
          if (e.key === "ArrowLeft") document.querySelector('a[rel="prev"]')?.click();
          if (e.key === "ArrowRight") document.querySelector('a[rel="next"]')?.click();
          return;
        }
        if (e.key === "Escape") close();
        if (e.key === "ArrowLeft") show(current - 1);
        if (e.key === "ArrowRight") show(current + 1);
      });

      const m = location.hash.match(/^#foto-(\d+)$/);
      if (m && Number(m[1]) >= 1 && Number(m[1]) <= items.length) open(Number(m[1]) - 1);
    })();
  </script>
</Layout>
