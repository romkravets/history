---
import Layout from "../layouts/Layout.astro";
import { SITE, SITE_NAME } from "../lib/site";
// 404 одна на обидві мови: український текст і посилання на польську головну
---

<Layout
  title={`Сторінку не знайдено · ${SITE_NAME}`}
  description={`Такої сторінки в архіві немає. Поверніться до галереї старих фото ${SITE.texts.coverage}.`}
  noindex
>
  <section class="shell">
    <div class="hero-page">
      <p class="eyebrow">▸ ПОМИЛКА 404</p>
      <h1>СТОРІНКУ<br /><span>НЕ ЗНАЙДЕНО</span></h1>
      <p class="lead">
        Можливо, адреса змінилась або галерею перенесли. Усі фото — в галереї
        архіву.
      </p>
      <div class="hero-actions">
        <a href="/" class="btn btn-accent">ДО ГАЛЕРЕЇ →</a>
        <a href="/karta/" class="btn">Карта фото</a>
        <a href="/pl/" class="btn" lang="pl">Wersja polska →</a>
      </div>
    </div>
  </section>
</Layout>
