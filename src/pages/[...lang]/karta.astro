---
import Layout from "../../layouts/Layout.astro";
import { SITE, absoluteUrl, landOf } from "../../lib/site";
import { getPhotos } from "../../i18n/content";
import { langPaths, lp, plural, t, type Lang } from "../../i18n/ui";

export const getStaticPaths = langPaths;
const lang = Astro.props.lang as Lang;
const T = t(lang);
const M = T.map;
const photos = (await getPhotos(lang)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const points = photos.flatMap((p) => {
  const loc = p.data.location;
  if (!loc) return [];
  return [
    {
      slug: p.id.replace(/\.md$/, ""),
      title: p.data.title,
      city: p.data.city,
      decade: p.data.decade,
      cover: p.data.cover,
      count: 1 + p.data.images.length,
      lat: loc.lat,
      lng: loc.lng,
      approximate: loc.approximate,
      land: landOf(p.orig.city)?.key ?? "",
    },
  ];
});

const places = new Set(points.map((p) => `${p.lat},${p.lng}`)).size;
const lands = SITE.lands
  .filter((l) => points.some((p) => p.land === l.key))
  .map((l) => ({ ...l, label: landOf(l.cities[0]!, lang)?.label ?? l.label }));
const offMap = photos.length - points.length;
const pageUrl = absoluteUrl(lp(lang, "/karta/"), Astro.site);
const prefix = lp(lang, "/").replace(/\/$/, "");
const popup = { approx: M.popupApprox, open: M.popupOpen, forms: T.home.photoForms, lang };
const siteUrl = absoluteUrl("/", Astro.site);
const jsonLd = [
  {
    "@type": "Map",
    "@id": `${pageUrl}#map`,
    url: pageUrl,
    name: `${T.nav.map}: ${T.siteName}`,
    inLanguage: lang,
    isPartOf: { "@id": `${siteUrl}#website` },
    mapType: "https://schema.org/VenueMap",
  },
];
---

<Layout
  title={`${M.title} · ${T.siteName}`}
  description={M.description(points.length, places, T.coverage)}
  jsonLd={jsonLd}
>
  <section class="shell">
    <div class="hero-page map-hero">
      <p class="eyebrow">{M.eyebrow}</p>
      <h1>{M.h1[0]}<br /><span>{M.h1[1]}</span></h1>
      <p class="lead">{M.lead(points.length, places)}</p>
    </div>
  </section>

  <section class="shell map-section">
    {
      lands.length > 1 && (
        <div class="decade-filter map-land-filter" role="group" aria-label={M.landLabel}>
          <button type="button" class="active" data-land="all" aria-pressed="true">{T.home.allLands}</button>
          {lands.map((l) => (
            <button type="button" data-land={l.key} aria-pressed="false">
              {l.label} <span>{points.filter((p) => p.land === l.key).length}</span>
            </button>
          ))}
        </div>
      )
    }
    <div id="archive-map" class="archive-map" role="region" aria-label={M.region} data-prefix={prefix}></div>
    <p class="map-note">
      <span class="map-dot" aria-hidden="true"></span> {M.exact}
      <span class="map-dot map-dot--approx" aria-hidden="true"></span> {M.approx}
      {offMap > 0 && M.offMap(offMap)}
    </p>

    <noscript>
      <ul class="map-list">
        {points.map((p) => <li><a href={lp(lang, `/photos/${p.slug}/`)}>{p.title}</a> — {p.city}</li>)}
      </ul>
    </noscript>
  </section>

  <script is:inline type="application/json" id="map-data" set:html={JSON.stringify(points)} />
  <script
    is:inline
    type="application/json"
    id="map-text"
    set:html={JSON.stringify({ ...popup, labels: points.map((p) => plural(lang, p.count, T.home.photoForms)) })}
  />

  <script>
    import L from "leaflet";
    import "leaflet.markercluster";
    import "leaflet/dist/leaflet.css";
    import "leaflet.markercluster/dist/MarkerCluster.css";

    type Point = {
      slug: string;
      title: string;
      city: string;
      decade: string;
      cover: string;
      count: number;
      lat: number;
      lng: number;
      approximate: boolean;
      land: string;
    };

    const el = document.getElementById("archive-map");
    const data: Point[] = JSON.parse(document.getElementById("map-data")?.textContent || "[]");
    const text: { approx: string; open: string; labels: string[] } = JSON.parse(
      document.getElementById("map-text")?.textContent || "{}",
    );
    const prefix = el?.dataset.prefix ?? "";

    if (el && data.length) {
      const map = L.map(el, { scrollWheelZoom: false, worldCopyJump: false });
      // колесо миші вмикається після кліку по карті, щоб сторінка нормально гортала
      map.once("focus", () => map.scrollWheelZoom.enable());
      map.on("click", () => map.scrollWheelZoom.enable());

      L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
        maxZoom: 19,
        className: "map-tiles",
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(map);

      const escape = (s: string) =>
        s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

      const icon = (approx: boolean) =>
        L.divIcon({
          className: "",
          html: `<span class="map-pin${approx ? " map-pin--approx" : ""}"></span>`,
          iconSize: [18, 18],
          iconAnchor: [9, 9],
          popupAnchor: [0, -10],
        });

      const cluster = L.markerClusterGroup({
        showCoverageOnHover: false,
        spiderfyDistanceMultiplier: 1.6,
        maxClusterRadius: 40,
        iconCreateFunction: (c) =>
          L.divIcon({
            className: "",
            html: `<span class="map-cluster">${c.getChildCount()}</span>`,
            iconSize: [40, 40],
          }),
      });

      const bySlug = new Map<string, L.Marker>();
      const markerLand = new Map<L.Marker, string>();
      for (const [i, p] of data.entries()) {
        const m = L.marker([p.lat, p.lng], { icon: icon(p.approximate), title: p.title, alt: p.title });
        m.bindPopup(
          `<a class="map-popup" href="${prefix}/photos/${p.slug}/">
            <img src="${p.cover}" alt="" loading="lazy" width="260" height="170" />
            <span class="map-popup-meta">${escape(p.city)} · ${escape(p.decade)}</span>
            <b>${escape(p.title)}</b>
            <span class="map-popup-more">${p.count} ${text.labels[i]}${p.approximate ? text.approx : ""}${text.open}</span>
          </a>`,
          { maxWidth: 280, minWidth: 260 },
        );
        bySlug.set(p.slug, m);
        markerLand.set(m, p.land);
        cluster.addLayer(m);
      }
      map.addLayer(cluster);

      // фільтр за краєм: перебудовує кластер і наближає до видимих точок
      const chips = document.querySelectorAll<HTMLButtonElement>(".map-land-filter button");
      chips.forEach((chip) =>
        chip.addEventListener("click", () => {
          chips.forEach((c) => {
            c.classList.toggle("active", c === chip);
            c.setAttribute("aria-pressed", String(c === chip));
          });
          const land = chip.dataset.land;
          cluster.clearLayers();
          const visible = [...markerLand].filter(([, l]) => land === "all" || l === land).map(([m]) => m);
          cluster.addLayers(visible);
          if (visible.length) map.fitBounds(cluster.getBounds(), { padding: [30, 30], maxZoom: 13 });
        }),
      );
      map.fitBounds(cluster.getBounds(), { padding: [30, 30] });

      // /karta/#slug — відкрити конкретну галерею (посилання «На карті»)
      const target = bySlug.get(decodeURIComponent(location.hash.slice(1)));
      if (target) {
        cluster.zoomToShowLayer(target, () => target.openPopup());
        el.scrollIntoView({ block: "center" });
      }
    }
  </script>
</Layout>
