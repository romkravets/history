---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import PhotoOfDay from "../components/PhotoOfDay.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import {
  SITE,
  SITE_NAME,
  SITE_TAGLINE,
  absoluteUrl,
  ERAS,
  citiesByWeight,
  erasOf,
  imageSize,
  pluralUk,
} from "../lib/site";

const photos = (await getCollection("photos")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const formatDate = new Intl.DateTimeFormat("uk-UA", {
  dateStyle: "long",
});

const toSlug = (id: string) => id.replace(/\.md$/, "");
const photoCount = photos.reduce((n, p) => n + 1 + p.data.images.length, 0);
// «Західна Україна» в реконструкціях — не місто, тож рахуємо лише галереї з місцем
const cityCount = new Set(photos.filter((p) => p.data.location !== false).map((p) => p.data.city)).size;
const eraCount = ERAS.filter((e) => photos.some((p) => erasOf(p.data.decade).includes(e.key))).length;
const withCompare = photos.find((p) => p.data.comparisons.length > 0);
const featuredCompare = withCompare && {
  ...withCompare.data.comparisons[0]!,
  slug: toSlug(withCompare.id),
};
const eraCounts = new Map<string, number>();
for (const p of photos)
  for (const e of erasOf(p.data.decade))
    eraCounts.set(e, (eraCounts.get(e) ?? 0) + 1);
const eraFilters = ERAS.filter((e) => eraCounts.has(e.key));

const cities = citiesByWeight(photos.map((p) => p.data.city));
const cityList =
  cities.length > 6 ? `${cities.slice(0, 6).join(", ")} та інші` : cities.join(", ");
const pageDescription = `Старі фотографії й листівки ${SITE.texts.coverage}: ${cityList}. ${photos.length} ${pluralUk(photos.length, ["галерея", "галереї", "галерей"])} з датами, описами та історією місць.`;

const coverSizes = await Promise.all(photos.map((p) => imageSize(p.data.cover)));

const siteUrl = absoluteUrl("/", Astro.site);
const jsonLd = [
  {
    "@type": "CollectionPage",
    "@id": `${siteUrl}#collection`,
    url: siteUrl,
    name: SITE_TAGLINE,
    description: pageDescription,
    inLanguage: "uk",
    isPartOf: { "@id": `${siteUrl}#website` },
    about: cities.map((name) => ({ "@type": "Place", name })),
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: photos.length,
      itemListElement: photos.map((photo, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: absoluteUrl(`/photos/${toSlug(photo.id)}/`, Astro.site),
        name: photo.data.title,
      })),
    },
  },
];
---

<Layout
  title={`${SITE_TAGLINE} · ${SITE_NAME}`}
  description={pageDescription}
  jsonLd={jsonLd}
>
  <section class="hero-full" aria-label="Про архів">
    <video
      class="hero-full-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster="/video/banner-poster.jpg"
      aria-hidden="true"
    >
      <source src="/video/banner.webm" type="video/webm" />
      <source src="/video/banner.mp4" type="video/mp4" />
    </video>
    <div class="hero-full-shade" aria-hidden="true"></div>

    <div class="shell hero-full-inner">
      <p class="eyebrow">▸ {SITE.texts.heroEyebrow}</p>
      <h1>
        {SITE.texts.heroTitle[0]}<br />
        <span>{SITE.texts.heroTitle[1]}</span> {SITE.texts.heroTitle[2]}
      </h1>
      <p class="hero-full-lead">
        Старі фото й листівки {SITE.texts.coverage}: {cityList}.
        Дати, місця, свідчення.
      </p>
      <div class="hero-actions">
        <a href="#gallery" class="btn btn-accent">Відкрити галерею ↓</a>
        <a href="/karta/" class="btn btn-glass">Карта фото →</a>
        <a href="/istoriya/" class="btn btn-glass">Історія {SITE.home.genitive} →</a>
      </div>

      <dl class="hero-stats">
        <div><dt>Галерей</dt><dd>{photos.length}</dd></div>
        <div><dt>Фото</dt><dd>{photoCount.toLocaleString("uk-UA")}</dd></div>
        <div><dt>Міст і сіл</dt><dd>{cityCount}</dd></div>
        <div><dt>Епох</dt><dd>{eraCount}</dd></div>
      </dl>
    </div>

    <button type="button" class="hero-video-toggle" aria-label="Зупинити відео" data-playing="true">❚❚</button>
  </section>

  <PhotoOfDay />

  {
    featuredCompare && (
      <section class="shell home-ba" aria-label="Тоді й тепер">
        <div class="home-ba-head">
          <h2 class="section-title">Тоді й тепер <small>— потягніть повзунок</small></h2>
          <div class="home-ba-links">
            <a href={`/photos/${featuredCompare.slug}/`}>Усі порівняння →</a>
            <a href="/marshruty/">Маршрут старим містом →</a>
          </div>
        </div>
        <BeforeAfter before={featuredCompare.before} after={featuredCompare.after} caption={featuredCompare.caption} />
      </section>
    )
  }

  <section class="ticker" aria-hidden="true">
    <div>
      <span>АРХІВ · КРАЙ · ПАМ'ЯТЬ</span>
      <span>///</span>
      <span>СТРІЧКА АКТИВНА</span>
      <span>///</span>
      <span>АРХІВ · КРАЙ · ПАМ'ЯТЬ</span>
      <span>///</span>
      <span>СТРІЧКА АКТИВНА</span>
    </div>
  </section>

  <div class="shell decade-filter-wrap">
    <div class="decade-filter" role="group" aria-label="Фільтр за епохою">
      <button type="button" class="active" data-era="all" aria-pressed="true">
        Усі <span>{photos.length}</span>
      </button>
      {
        eraFilters.map((e) => (
          <button type="button" data-era={e.key} aria-pressed="false">
            {e.label} <span>{eraCounts.get(e.key)}</span>
          </button>
        ))
      }
    </div>
  </div>

  <section id="gallery" class="shell grid" aria-label="Галерея світлин">
    {
      photos.map((photo, i) => (
        <a
          class="card"
          data-eras={erasOf(photo.data.decade).join(" ")}
          href={`/photos/${toSlug(photo.id)}/`}
        >
          <div class="card-media">
            <img
              src={photo.data.cover}
              alt={`${photo.data.title} — ${photo.data.city}, ${photo.data.decade}`}
              width={coverSizes[i]?.width}
              height={coverSizes[i]?.height}
              loading="lazy"
              decoding="async"
            />
            <span class="card-count" aria-label={`${1 + photo.data.images.length} фото в галереї`}>
              <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path fill="currentColor" d="M2 4h9v8H2zM5 2h9v8h-1V3H5z"/></svg>
              {1 + photo.data.images.length} фото
            </span>
          </div>
          <div class="card-body">
            <p class="meta">
              [{photo.data.decade}] · {photo.data.city}
            </p>
            <h2>{photo.data.title}</h2>
            <p class="date">{formatDate.format(photo.data.date)}</p>
            <p>{photo.data.description}</p>
            <p class="card-more">ВІДКРИТИ →</p>
          </div>
        </a>
      ))
    }
  </section>

  <script is:inline>
    (() => {
      const video = document.querySelector(".hero-full-video");
      const toggle = document.querySelector(".hero-video-toggle");
      if (!video || !toggle) return;
      const set = (playing) => {
        toggle.dataset.playing = String(playing);
        toggle.textContent = playing ? "❚❚" : "▶";
        toggle.setAttribute("aria-label", playing ? "Зупинити відео" : "Відтворити відео");
      };
      // з налаштуванням «зменшити рух» відео не грає — лишається постер
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
        video.removeAttribute("autoplay");
        video.pause();
        set(false);
      }
      toggle.addEventListener("click", () => {
        if (video.paused) { video.play(); set(true); } else { video.pause(); set(false); }
      });
    })();
  </script>

  <script is:inline>
    (() => {
      const chips = document.querySelectorAll(".decade-filter button");
      const cards = document.querySelectorAll("#gallery .card");
      chips.forEach((chip) => {
        chip.addEventListener("click", () => {
          chips.forEach((c) => {
            c.classList.toggle("active", c === chip);
            c.setAttribute("aria-pressed", String(c === chip));
          });
          chip.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
          const era = chip.dataset.era;
          cards.forEach((card) => {
            const show = era === "all" || card.dataset.eras.split(" ").includes(era);
            card.classList.toggle("is-hidden", !show);
          });
        });
      });
    })();
  </script>
</Layout>
